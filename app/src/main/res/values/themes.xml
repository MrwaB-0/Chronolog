<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Chronolog" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:textColorPrimary">@color/body</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>

    <style name="Widget.Chronolog.Button" parent="@android:style/Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/body</item>
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.Chronolog.Button.Ghost" parent="Widget.Chronolog.Button">
        <item name="android:background">@drawable/btn_ghost</item>
    </style>

    <style name="Widget.Chronolog.Button.Accent" parent="Widget.Chronolog.Button">
        <item name="android:background">@drawable/btn_start</item>
        <item name="android:textColor">#FF04231A</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="Widget.Chronolog.Button.Danger" parent="Widget.Chronolog.Button">
        <item name="android:background">@drawable/btn_stop</item>
        <item name="android:textColor">#FF2A0A05</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="Widget.Chronolog.Button.Small" parent="Widget.Chronolog.Button">
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
    </style>

    <style name="Text.Chronolog.Section" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="Text.Chronolog.Caption" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

</resources>
