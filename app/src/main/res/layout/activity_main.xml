<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <!-- 헤더 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.22"
                    android:text="@string/app_name"
                    android:textColor="@color/title"
                    android:textSize="23sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/app_tagline"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSound"
                style="@style/Widget.Chronolog.Button.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sound_on" />
        </LinearLayout>

        <!-- 아날로그 크로노그래프 다이얼 -->
        <com.marwabadak.chronolog.ui.ChronographDialView
            android:id="@+id/dial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <!-- 디지털 표시 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvDigital"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="42sp"
                android:autoSizeMinTextSize="18sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="monospace"
                android:fontFeatureSettings="tnum"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:text="@string/digital_zero"
                android:textColor="@color/title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWindow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:fontFeatureSettings="tnum"
                android:gravity="center_horizontal"
                android:lineSpacingExtra="3dp"
                android:text="@string/window_idle"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 컨트롤 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartStop"
                style="@style/Widget.Chronolog.Button.Accent"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1.7"
                android:text="@string/btn_start" />

            <Button
                android:id="@+id/btnReset"
                style="@style/Widget.Chronolog.Button.Ghost"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/btn_reset" />
        </LinearLayout>

        <!-- 백그라운드 측정 안내 -->
        <TextView
            android:id="@+id/tvServiceState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/background_state_idle"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <!-- 캘린더 연동 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPickCalendar"
                    style="@style/Widget.Chronolog.Button.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/calendar_pick" />
            </LinearLayout>

            <Switch
                android:id="@+id/switchAutoCalendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="false"
                android:text="@string/calendar_auto"
                android:textColor="@color/body"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 기록 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Chronolog.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_records" />

            <TextView
                android:id="@+id/tvRecordCount"
                style="@style/Text.Chronolog.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnClearAll"
                style="@style/Widget.Chronolog.Button.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clear_all_button" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:padding="22dp"
            android:text="@string/records_empty"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/recordsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
